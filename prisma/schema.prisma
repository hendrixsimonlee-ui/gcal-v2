// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models ---

enum DanceRole {
  DANCER
  CHOREOGRAPHER
}

enum PracticeStatus {
  PROPOSED
  CONFIRMED
}

enum NotificationType {
  SCHEDULE_FINALIZED
  REMINDER
  CHRONIC_ABSENCE_FLAG
  CHECK_IN_OPEN
  ATTENDANCE_DUE
  PRACTICE_CHANGED
}

/// Dancers no longer categorise their own conflicts — they type a title and
/// the AD decides. NOT_REVIEWED is a real third state so the review screen
/// can show exactly what hasn't been looked at yet.
enum ConflictStatus {
  NOT_REVIEWED
  EXCUSED
  UNEXCUSED
}

/// What actually happened for one person at one practice. Derived from their
/// check-in where there is one, and from their reviewed conflicts where there
/// isn't; a choreographer or admin can override any of it.
enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)

  // Attendance threshold override; falls back to a global setting if null.
  chronicAbsenceThreshold Int?

  /// Which of this person's Google calendars holds their conflicts. The team
  /// makes everyone a dedicated PADT conflict calendar at the start of the
  /// year, so importing from "primary" pulls the wrong thing. Null means
  /// they haven't picked one yet.
  conflictCalendarId   String?
  conflictCalendarName String?

  accounts Account[]
  sessions Session[]

  memberships         DanceMembership[]
  conflicts           Conflict[]
  unavailabilities    Unavailability[]
  weeklyExcuses       ChoreographerWeeklyExcuse[]
  attendanceRecords   Attendance[]                @relation("AttendanceSubject")
  attendanceMarkedBy  Attendance[]                @relation("AttendanceMarker")
  attendanceSubmitted Practice[]                  @relation("AttendanceSubmitter")
  conflictsReviewed   Conflict[]                  @relation("ConflictReviewer")
  plannedArrivals     PlannedArrival[]
  notesWritten        PracticeNote[]              @relation("NoteAuthor")
  notesAbout          PracticeNote[]              @relation("NoteSubject")
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dance {
  id     String  @id @default(cuid())
  name   String
  season String?

  /// Set when the AD archives a finished piece. Archived dances disappear
  /// from scheduling and from everyone's personal screens, but all their
  /// practices and attendance stay in the database — unarchiving brings it
  /// all back.
  archivedAt DateTime?

  /// How long this piece's practices usually run. The Schedule Builder starts
  /// from this so the AD isn't retyping "90" for every dance, and the tracker
  /// can show the expected length before anything is booked.
  defaultDurationMinutes Int @default(90)

  memberships   DanceMembership[]
  practices     Practice[]
  weeklyExcuses ChoreographerWeeklyExcuse[]
  weeksOff      DanceWeekOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The AD marking a dance as deliberately not rehearsing in a given week.
/// Without this, "no practice booked" and "no practice wanted" look identical
/// on the tracker, and the AD can never tick the week off as done.
model DanceWeekOff {
  id      String   @id @default(cuid())
  danceId String
  weekOf  DateTime
  note    String?

  dance Dance @relation(fields: [danceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([danceId, weekOf])
  @@index([weekOf])
}

model DanceMembership {
  id      String    @id @default(cuid())
  userId  String
  danceId String
  role    DanceRole

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dance Dance @relation(fields: [danceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, danceId, role])
  @@index([danceId])
  @@index([userId])
}

model Space {
  id       String  @id @default(cuid())
  name     String
  location String?

  /// The Google Calendar this room's bookings live on, if the AD has linked
  /// one. Each event on it is a block the space is open to the team.
  googleCalendarId   String?
  googleCalendarName String?

  /// The normalised form of `name`, used to match titles coming off the
  /// shared spaces calendar. "EM SACHS", "em sachs" and "emsachs" all reduce
  /// to the same key and land on this one room.
  matchKey String? @unique

  availabilities SpaceAvailability[]
  practices      Practice[]
  nameReviews    SpaceNameReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A recurring weekly window (dayOfWeek + start/end time) or a one-off date
/// override for when a space is actually bookable.
model SpaceAvailability {
  id      String @id @default(cuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Recurring weekly window
  dayOfWeek Int? // 0 = Sunday ... 6 = Saturday
  startTime String? // "HH:mm"
  endTime   String? // "HH:mm"

  // One-off override (a specific date, e.g. holiday closure or extra opening)
  date        DateTime? @db.Date
  isAvailable Boolean   @default(true)

  /// Set when this window came from the space's Google Calendar. Re-importing
  /// updates the matching row instead of piling up duplicates, and hand-made
  /// windows (no source id) are never touched by an import.
  sourceGoogleEventId String?

  createdAt DateTime @default(now())

  @@index([spaceId])
  @@index([sourceGoogleEventId])
}

/// A dancer/choreographer's logged conflict for a given week. May originate
/// from a manual entry or be imported from Google Calendar (sourceGoogleEventId set).
model Conflict {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekOf        DateTime @db.Date
  startDateTime DateTime
  endDateTime   DateTime

  /// What the conflict is, in the dancer's own words — or the event title
  /// straight off their PADT conflict calendar. This is the thing the AD
  /// reads when deciding whether to excuse it.
  title String?

  status ConflictStatus @default(NOT_REVIEWED)

  /// Who marked it excused/unexcused, and when. Kept so the AD can see a
  /// decision was made deliberately rather than defaulted into.
  reviewedById String?
  reviewedBy   User?     @relation("ConflictReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  isRecurring    Boolean @default(false)
  recurrenceRule String? // e.g. "WEEKLY" for now; RFC 5545 RRULE later if needed

  sourceGoogleEventId String? // set when imported from Google Calendar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekOf])
  @@index([status])
}

/// A full exclusion window (e.g. "out of town") distinct from a normal
/// conflict — removes the user from conflict-checking entirely for the range.
model Unavailability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Practice {
  id      String @id @default(cuid())
  danceId String
  dance   Dance  @relation(fields: [danceId], references: [id], onDelete: Cascade)

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  startDateTime DateTime
  endDateTime   DateTime
  status        PracticeStatus @default(PROPOSED)

  /// When the practice actually got going, if that wasn't the scheduled
  /// time. Lateness is measured from here when it's set — nobody should be
  /// marked late for a practice that hadn't started.
  actualStartTime DateTime?

  /// Set when the choreographer (or an admin on their behalf) signs off on
  /// the attendance record. Until then it's provisional. There's deliberately
  /// no deadline on this.
  attendanceSubmittedAt   DateTime?
  attendanceSubmittedById String?
  attendanceSubmittedBy   User?     @relation("AttendanceSubmitter", fields: [attendanceSubmittedById], references: [id])

  /// The event this practice owns on the shared team calendar, so an edit
  /// updates that event in place instead of creating a second one.
  googleEventId String?

  attendance      Attendance[]
  plannedArrivals PlannedArrival[]
  notes           PracticeNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([danceId])
  @@index([spaceId])
}

/// The AD deselecting a choreographer as a mandatory attendee for one
/// specific week (that dance's weekly excuse), rather than every week.
model ChoreographerWeeklyExcuse {
  id      String   @id @default(cuid())
  danceId String
  dance   Dance    @relation(fields: [danceId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekOf  DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([danceId, userId, weekOf])
}

model Attendance {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("AttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)

  status AttendanceStatus

  /// The moment they tapped Check in. Null for anyone who never did.
  checkedInAt DateTime?

  /// How late they were, in minutes, measured from the practice's real start
  /// and against any agreed late arrival. Stored at minute resolution so
  /// charge rules can be layered on later without re-collecting anything.
  minutesLate Int?

  /// True when a person or admin changed what the check-in implied, so the
  /// record shows the difference between what happened and what was decided.
  isOverride Boolean @default(false)

  markedById String?
  markedBy   User?    @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt   DateTime @default(now())

  @@unique([practiceId, userId])
  @@index([userId])
}

/// Someone who has agreed in advance to arrive part-way through — a class
/// that runs to 6:15 against a 6:00 call. Entered once while scheduling
/// rather than explained again every week. Arriving by this time counts as
/// on time.
model PlannedArrival {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The time they're expected to walk in.
  arriveAt DateTime
  reason   String?

  createdAt DateTime @default(now())

  @@unique([practiceId, userId])
  @@index([userId])
}

/// A note attached to a practice, optionally about one person.
///
/// `subjectUserId` null means it's about the practice itself and the whole
/// cast can read it. Set, it's about that person — visible to them, their
/// choreographers, and admins — which covers both "I'll be late, class runs
/// over" written beforehand and "here's what she missed" written after.
model PracticeNote {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  subjectUserId String?
  subject       User?   @relation("NoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId])
  @@index([subjectUserId])
}

/// Single-row table of org-wide settings the AD controls. Kept as a table
/// (rather than env vars) so the AD can change it from the Settings screen.
model AppSettings {
  id String @id @default("singleton")

  /// Someone is flagged as chronically absent after this many unexcused
  /// absences within the last `chronicAbsenceWindow` practices for a dance.
  /// A `User.chronicAbsenceThreshold` overrides this per person.
  chronicAbsenceThreshold Int @default(3)
  chronicAbsenceWindow    Int @default(5)

  /// When on, slot ranking nudges away from times a dance's cast has
  /// historically skipped. The AD can switch it off to get purely
  /// rule-based suggestions with no inference from past data.
  useHistoricalWeighting Boolean @default(true)

  /// The shared team calendar every published practice is written to. Owned
  /// by the club account and shared with the AD, whose Google token does the
  /// writing — so it survives ADs changing.
  teamCalendarId   String?
  teamCalendarName String?

  /// Someone is counted late from this many minutes past the start. Under it
  /// is on time.
  lateThresholdMinutes Int @default(5)

  /// One calendar carrying every room's bookings, rather than one per space.
  /// Syncing it is the first step of setting up a term: the events on it are
  /// grouped by title into spaces, and each event becomes a window that room
  /// is available. Per-space calendars still work for anyone already using
  /// them; this is the flow the AD is pointed at first.
  spacesCalendarId   String?
  spacesCalendarName String?

  updatedAt DateTime @updatedAt
}

/// A named stretch of the year the AD defines once — "Fall 2026",
/// "Spring 2027". Anywhere the app needs a date range (syncing a calendar,
/// searching for slots, reporting attendance) it offers these rather than
/// asking for raw dates or assuming a fixed number of weeks ahead.
model Term {
  id   String @id @default(cuid())
  name String

  /// Inclusive. Held as bare calendar dates: a term starts on a day, not at
  /// an instant, and shouldn't shift with the clock.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// The term new work defaults to. Exactly one is current at a time; setting
  /// another clears this one.
  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([startDate])
}

/// A space title seen on the shared spaces calendar that didn't match any
/// known room. Held here rather than silently creating a space, so the AD
/// decides whether "Platt B" is a new room or another spelling of one that
/// already exists.
model SpaceNameReview {
  id String @id @default(cuid())

  /// Exactly as it appeared on the calendar, for the AD to recognise.
  rawTitle String
  /// The normalised form used for matching — lowercased, punctuation and
  /// spacing stripped. Two titles sharing this are the same room.
  matchKey String @unique

  /// How many events carried this title in the last sync, so the AD can tell
  /// a real room from a one-off typo.
  eventCount Int @default(0)

  /// Set once the AD resolves it: either mapped onto an existing space or
  /// turned into a new one. Resolved rows are kept so the same title isn't
  /// queued again on the next sync.
  resolvedSpaceId String?
  resolvedSpace   Space?  @relation(fields: [resolvedSpaceId], references: [id], onDelete: SetNull)
  /// Set when the AD explicitly says this title is not a room.
  ignored Boolean @default(false)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([ignored, resolvedSpaceId])
}

/// A browser/phone that has agreed to receive push notifications. One person
/// can have several — phone and laptop. On iOS these only exist once the app
/// has been added to the home screen; that's an Apple rule, not a choice.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  message String
  /// Where tapping the notification should take them.
  href    String?
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}
