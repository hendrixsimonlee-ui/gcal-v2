// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models ---

enum DanceRole {
  DANCER
  CHOREOGRAPHER
}

enum PracticeStatus {
  PROPOSED
  CONFIRMED
}

enum NotificationType {
  SCHEDULE_FINALIZED
  REMINDER
  CHRONIC_ABSENCE_FLAG
  CHECK_IN_OPEN
  ATTENDANCE_DUE
  PRACTICE_CHANGED
  CONFLICTS_DUE
}

/// Dancers no longer categorise their own conflicts — they type a title and
/// the AD decides. NOT_REVIEWED is a real third state so the review screen
/// can show exactly what hasn't been looked at yet.
enum ConflictStatus {
  NOT_REVIEWED
  EXCUSED
  UNEXCUSED
}

/// What actually happened for one person at one practice. Derived from their
/// check-in where there is one, and from their reviewed conflicts where there
/// isn't; a choreographer or admin can override any of it.
enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)

  // Attendance threshold override; falls back to a global setting if null.
  chronicAbsenceThreshold Int?

  /// Which of this person's Google calendars holds their conflicts. The team
  /// makes everyone a dedicated PADT conflict calendar at the start of the
  /// year, so importing from "primary" pulls the wrong thing. Null means
  /// they haven't picked one yet.
  conflictCalendarId   String?
  conflictCalendarName String?

  accounts Account[]
  sessions Session[]

  memberships         DanceMembership[]
  conflicts           Conflict[]
  unavailabilities    Unavailability[]
  weeklyExclusions    WeeklyExclusion[]
  attendanceRecords   Attendance[]                @relation("AttendanceSubject")
  attendanceMarkedBy  Attendance[]                @relation("AttendanceMarker")
  attendanceSubmitted Practice[]                  @relation("AttendanceSubmitter")
  conflictsReviewed   Conflict[]                  @relation("ConflictReviewer")
  plannedArrivals     PlannedArrival[]
  notesWritten        PracticeNote[]              @relation("NoteAuthor")
  notesAbout          PracticeNote[]              @relation("NoteSubject")
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  conflictSubmissions ConflictSubmission[]
  exclusionsAuthored  WeeklyExclusion[]           @relation("ExclusionAuthor")
  weeksReviewed       AttendanceWeekReview[]      @relation("WeekReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dance {
  id     String  @id @default(cuid())
  name   String
  season String?

  /// Set when the AD archives a finished piece. Archived dances disappear
  /// from scheduling and from everyone's personal screens, but all their
  /// practices and attendance stay in the database — unarchiving brings it
  /// all back.
  archivedAt DateTime?

  /// How long this piece's practices usually run. The Schedule Builder starts
  /// from this so the AD isn't retyping "90" for every dance, and the tracker
  /// can show the expected length before anything is booked.
  defaultDurationMinutes Int @default(90)

  memberships   DanceMembership[]
  practices     Practice[]
  exclusions    WeeklyExclusion[]
  weeksOff      DanceWeekOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The AD marking a dance as deliberately not rehearsing in a given week.
/// Without this, "no practice booked" and "no practice wanted" look identical
/// on the tracker, and the AD can never tick the week off as done.
model DanceWeekOff {
  id      String   @id @default(cuid())
  danceId String
  weekOf  DateTime
  note    String?

  /// Set when marking the week off cleared practices the cast had already been
  /// told about. Nothing is sent automatically — the tracker shows "cancelled,
  /// nobody told" until the AD decides, because a cancellation is exactly the
  /// kind of message that should be a choice rather than a side effect.
  pendingCancellationNotice Boolean @default(false)
  /// How many published practices were cleared, so the prompt can say what it
  /// is asking about.
  cancelledPracticeCount Int @default(0)

  dance Dance @relation(fields: [danceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([danceId, weekOf])
  @@index([weekOf])
}

model DanceMembership {
  id      String    @id @default(cuid())
  userId  String
  danceId String
  role    DanceRole

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dance Dance @relation(fields: [danceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, danceId, role])
  @@index([danceId])
  @@index([userId])
}

/// A room, derived entirely from the shared spaces calendar.
///
/// The name is an event title, copied exactly. There is no fuzzy matching any
/// more: "EM SACHS" and "Em Sachs Theater" are two rooms, because they are two
/// titles. That's the trade for the app never guessing — keeping the titles
/// consistent is a job for whoever writes the calendar, and it's a job they
/// can actually see themselves doing.
///
/// Nothing in the app creates a space. Sync does, or it doesn't exist.
model Space {
  id       String  @id @default(cuid())
  name     String  @unique
  /// Straight off the event's own location field.
  location String?

  bookings  Booking[]
  practices Practice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One event on the spaces calendar: this room is ours, this date, these
/// hours.
///
/// Every column is required and every row has a source event, because the
/// calendar is now the only way a booking can exist. The old model carried
/// recurring weekly hours and hand-typed closures as well; both are gone —
/// an opening the calendar doesn't know about is a room nobody reserved, and
/// a closure is deleting the event.
model Booking {
  id      String @id @default(cuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  startTime String // "HH:mm", Eastern
  endTime   String // "HH:mm", Eastern

  /// The event this row mirrors. Unique, so a sync updates in place rather
  /// than piling up duplicates, and so an edit here knows what to patch.
  sourceGoogleEventId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, date])
  @@index([date])
}

/// A dancer/choreographer's logged conflict for a given week. May originate
/// from a manual entry or be imported from Google Calendar (sourceGoogleEventId set).
model Conflict {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekOf        DateTime @db.Date
  startDateTime DateTime
  endDateTime   DateTime

  /// What the conflict is, in the dancer's own words — or the event title
  /// straight off their PADT conflict calendar. This is the thing the AD
  /// reads when deciding whether to excuse it.
  title String?

  status ConflictStatus @default(NOT_REVIEWED)

  /// Who marked it excused/unexcused, and when. Kept so the AD can see a
  /// decision was made deliberately rather than defaulted into.
  reviewedById String?
  reviewedBy   User?     @relation("ConflictReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  isRecurring    Boolean @default(false)
  recurrenceRule String? // e.g. "WEEKLY" for now; RFC 5545 RRULE later if needed

  sourceGoogleEventId String? // set when imported from Google Calendar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekOf])
  @@index([status])
}

/// A full exclusion window (e.g. "out of town") distinct from a normal
/// conflict — removes the user from conflict-checking entirely for the range.
model Unavailability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Practice {
  id      String @id @default(cuid())
  danceId String
  dance   Dance  @relation(fields: [danceId], references: [id], onDelete: Cascade)

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  startDateTime DateTime
  endDateTime   DateTime
  status        PracticeStatus @default(PROPOSED)

  /// When the practice actually got going, if that wasn't the scheduled
  /// time. Lateness is measured from here when it's set — nobody should be
  /// marked late for a practice that hadn't started.
  actualStartTime DateTime?

  /// Set when the choreographer (or an admin on their behalf) signs off on
  /// the attendance record. Until then it's provisional. There's deliberately
  /// no deadline on this.
  attendanceSubmittedAt   DateTime?
  attendanceSubmittedById String?
  attendanceSubmittedBy   User?     @relation("AttendanceSubmitter", fields: [attendanceSubmittedById], references: [id])

  /// The event this practice owns on the shared team calendar, so an edit
  /// updates that event in place instead of creating a second one.
  googleEventId String?

  /// When this practice was first published. Distinct from `status` because
  /// the AD can unpublish and republish; this is the first time the cast was
  /// ever told it exists.
  publishedAt DateTime?

  /// The last time the cast was actually told about this practice, and
  /// whether it has been edited since. Between those two, the app knows the
  /// difference between "published and accurate" and "published, then moved,
  /// and nobody has been told yet" — which is what stops every drag of a
  /// published practice from firing a notification at forty people.
  announcedAt         DateTime?
  pendingAnnouncement Boolean   @default(false)

  /// What changed since the last announcement, in plain words ("moved to
  /// Thursday 7:00pm", "room changed to Platt Studio B"). Collected so the
  /// announcement can say what happened instead of "something changed".
  pendingChangeNote String?

  attendance      Attendance[]
  plannedArrivals PlannedArrival[]
  notes           PracticeNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([danceId])
  @@index([spaceId])
}

/// The AD taking one person out of one dance's scheduling for one week.
///
/// Covers both roles. It replaces the old choreographer-only excuse table and
/// the dancer "ignore" checkbox, which was session-only client state that
/// vanished on refresh and left no trace at all.
///
/// Leaving a record is the point. Someone left out of a week's scheduling who
/// then doesn't turn up must not be marked unexcused for it — the app is the
/// reason they weren't there. `reason` is filled from the conflicts that
/// prompted it and can be overwritten by hand.
model WeeklyExclusion {
  id      String   @id @default(cuid())
  danceId String
  dance   Dance    @relation(fields: [danceId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekOf  DateTime @db.Date

  reason String?

  createdById String?
  createdBy   User?   @relation("ExclusionAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([danceId, userId, weekOf])
  @@index([userId, weekOf])
}

model Attendance {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("AttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)

  status AttendanceStatus

  /// The moment they tapped Check in. Null for anyone who never did.
  checkedInAt DateTime?

  /// How late they were, in minutes, measured from the practice's real start
  /// and against any agreed late arrival. Stored at minute resolution so
  /// charge rules can be layered on later without re-collecting anything.
  minutesLate Int?

  /// True when a person or admin changed what the check-in implied, so the
  /// record shows the difference between what happened and what was decided.
  isOverride Boolean @default(false)

  markedById String?
  markedBy   User?    @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt   DateTime @default(now())

  @@unique([practiceId, userId])
  @@index([userId])
}

/// Someone who has agreed in advance to arrive part-way through — a class
/// that runs to 6:15 against a 6:00 call. Entered once while scheduling
/// rather than explained again every week. Arriving by this time counts as
/// on time.
model PlannedArrival {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The time they're expected to walk in.
  arriveAt DateTime
  reason   String?

  createdAt DateTime @default(now())

  @@unique([practiceId, userId])
  @@index([userId])
}

/// A note attached to a practice, optionally about one person.
///
/// `subjectUserId` null means it's about the practice itself and the whole
/// cast can read it. Set, it's about that person — visible to them, their
/// choreographers, and admins — which covers both "I'll be late, class runs
/// over" written beforehand and "here's what she missed" written after.
model PracticeNote {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  subjectUserId String?
  subject       User?   @relation("NoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId])
  @@index([subjectUserId])
}

/// Single-row table of org-wide settings the AD controls. Kept as a table
/// (rather than env vars) so the AD can change it from the Settings screen.
model AppSettings {
  id String @id @default("singleton")

  /// Someone is flagged as chronically absent after this many unexcused
  /// absences within the last `chronicAbsenceWindow` practices for a dance.
  /// A `User.chronicAbsenceThreshold` overrides this per person.
  chronicAbsenceThreshold Int @default(3)
  chronicAbsenceWindow    Int @default(5)

  /// When on, slot ranking nudges away from times a dance's cast has
  /// historically skipped. The AD can switch it off to get purely
  /// rule-based suggestions with no inference from past data.
  useHistoricalWeighting Boolean @default(true)

  /// The shared team calendar every published practice is written to. Owned
  /// by the club account and shared with the AD, whose Google token does the
  /// writing — so it survives ADs changing.
  teamCalendarId   String?
  teamCalendarName String?

  /// Someone is counted late from this many minutes past the start. Under it
  /// is on time.
  lateThresholdMinutes Int @default(5)

  /// The one calendar every room's bookings live on. It is the only source of
  /// spaces: an event's title is the room, its location is the location, and
  /// its times are when that room is ours. Nothing else creates a space.
  spacesCalendarId   String?
  spacesCalendarName String?

  updatedAt DateTime @updatedAt
}

/// A named stretch of the year the AD defines once — "Fall 2026",
/// "Spring 2027". Anywhere the app needs a date range (syncing a calendar,
/// searching for slots, reporting attendance) it offers these rather than
/// asking for raw dates or assuming a fixed number of weeks ahead.
model Term {
  id   String @id @default(cuid())
  name String

  /// Inclusive. Held as bare calendar dates: a term starts on a day, not at
  /// an instant, and shouldn't shift with the clock.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// The term new work defaults to. Exactly one is current at a time; setting
  /// another clears this one.
  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([startDate])
}

/// A dancer saying "my conflicts for this week are in".
///
/// Without this the AD can't tell an empty week apart from a week someone
/// hasn't got round to yet, which is the difference between scheduling around
/// them confidently and scheduling on top of a class they never logged.
model ConflictSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekOf DateTime @db.Date

  /// Null while the row exists only to remember a nudge. "Submitted" is the
  /// dancer's own act and nothing else may set it — an AD reminder must never
  /// make someone look like they answered.
  submittedAt DateTime?

  /// The last time the AD nudged them about this week, so a second nudge is
  /// a deliberate act rather than an accident of clicking twice.
  nudgedAt DateTime?

  @@unique([userId, weekOf])
  @@index([weekOf])
}

/// The AD ticking a week off as reviewed on the attendance archive. Locks
/// that week's records against accidental edits; reopening is one click and
/// leaves the row behind, so the tick is a working state rather than a
/// one-way door.
model AttendanceWeekReview {
  id     String   @id @default(cuid())
  weekOf DateTime @unique @db.Date

  reviewedAt   DateTime @default(now())
  reviewedById String?
  reviewedBy   User?    @relation("WeekReviewer", fields: [reviewedById], references: [id])

  @@index([weekOf])
}

/// A browser/phone that has agreed to receive push notifications. One person
/// can have several — phone and laptop. On iOS these only exist once the app
/// has been added to the home screen; that's an Apple rule, not a choice.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  message String
  /// Where tapping the notification should take them.
  href    String?
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}
